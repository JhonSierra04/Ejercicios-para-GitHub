Algoritmo AreayPerimetro
	
	Definir altura, base Como Real
	
	Escribir "Hola apreciado usuario";
	Escribir "Por favor digite la base del rectangulo";
	Leer base;
	
	Escribir "Digite la altura del resctangulo";
	Leer altura;
	
	area<-base*altura;
	perimetro<-2*(base+altura)
	
	Escribir "El area del rectangulo es:",area;
	Escribir "El perimetro del rectangulo es: ",perimetro;
	
FinAlgoritmo
